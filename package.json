{
  "name": "todara-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "design:shot": "node tools/design-shot.mjs",
    "design:compare": "node tools/compare.mjs",
    "media:upload": "node tools/upload-media.mjs",
    "audit": "pnpm audit --prod",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "^2.9.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.10.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^26.1.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "sharp": "0.35.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "overrides": {
      "zod@<4.6.6": "^4.6.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
