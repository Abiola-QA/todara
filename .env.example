# Copy to .env.local for local development. Every variable is optional locally.

# Public origin, used for canonical links, the sitemap and social cards.
SITE_URL=https://todarakenya.com
# "on" only on the production deployment; anything else keeps the site out of search engines.
SITE_INDEXING=off

# Photos: the Vercel Blob store's public origin (printed by `pnpm media:upload`).
# Without it, photos are served from public/media.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Only needed to run `pnpm media:upload`. Never commit it.
BLOB_READ_WRITE_TOKEN=

# Quote requests: "resend" emails them through Resend (default in production), "none" only logs them.
FORMS_DELIVERY=none
RESEND_API_KEY=
QUOTE_TO_EMAIL=export@todarakenya.com
FORMS_FROM_EMAIL=Todara website <website@todarakenya.com>
# Website address used inside the quote emails only (links, site name). Empty = SITE_URL.
EMAIL_SITE_URL=
